VITE_API_BASE_URL=http://localhost:3000/api
# Backend API URL — all AI services (including voice) go through the backend
VITE_API_URL=http://localhost:3000
# RAG/Chatbot service (used for /ask, /describe, /identify — not for voice)
VITE_CHATBOT_URL=http://localhost:8001
# Voice audio files are still served by the voice service (port 8003 must be reachable by the browser)
# The backend proxies the narration request but the audio MP3 URL is served directly from the voice service
VITE_VOICE_SERVICE_URL=http://localhost:8003
# Alternative local backend:
# VITE_API_BASE_URL=http://localhost:5000/api
